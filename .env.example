# Provider: "ollama" (locale, gratis) oppure "openai"
PROVIDER=ollama

# Ollama (API compatibile OpenAI, supporta il function calling)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# OpenAI (quando avrai la chiave)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Qwen3: true disattiva il "ragionamento" (risposte più rapide), false lo attiva
QWEN_NO_THINK=true
